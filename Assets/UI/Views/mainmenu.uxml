<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="healthbar_bg" style="flex-grow: 1; position: absolute; width: 300px; height: 50px; background-image: url(&quot;project://database/Assets/UI/Components/HealthBar/Sprites/horizontal_background.png?fileID=2800000&amp;guid=7a851d058d742d24fac8729d192d78d2&amp;type=3#horizontal_background&quot;); align-items: center; justify-content: flex-end; align-self: center; margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px;">
        <ui:Label text="0" name="health_label" style="align-items: center; position: absolute; font-size: 20px; -unity-text-align: middle-left; top: 50px; left: 248px; -unity-font-style: bold; justify-content: space-between; align-self: center;" />
        <ui:VisualElement name="health_mask" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; overflow: hidden; align-items: flex-start; align-self: flex-start; transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-in-out-sine;">
            <ui:VisualElement name="fill" style="flex-grow: 1; position: absolute; width: 296px; height: 100%; background-image: url(&quot;project://database/Assets/UI/Components/HealthBar/Sprites/detailed_fill.png?fileID=2800000&amp;guid=6751c086e4f93d74bb195480995b02a8&amp;type=3#detailed_fill&quot;); left: 4px; overflow: hidden;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="bottom_menu_options" style="flex-grow: 1; flex-direction: row; align-items: flex-end; justify-content: center; position: relative; height: 111px; width: 2769px; top: 0%; left: 0%; -unity-text-align: middle-center; text-overflow: ellipsis; flex-wrap: wrap; flex-shrink: 1; align-self: center; align-content: center; margin-bottom: 0;">
        <ui:Button text="HELP" name="help" style="height: 53px; width: 157px; -unity-text-align: middle-center; justify-content: center; align-self: flex-end; align-content: flex-start; align-items: center; flex-wrap: nowrap; flex-direction: column; margin: 10px; overflow: visible; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=6936960519852013934&amp;guid=e33cdd47a72c4964c9659cca1b0bc20d&amp;type=3#arrow-up@2x&quot;);" />
        <ui:Button text="LOWER HEALTH" name="DEBUG_LWR_H" style="height: 56px; width: 148px; -unity-text-align: middle-center; justify-content: center; align-self: flex-end; align-content: center; align-items: center; flex-wrap: nowrap; flex-direction: column; margin: 10px; overflow: visible; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=4154780841294389669&amp;guid=e33cdd47a72c4964c9659cca1b0bc20d&amp;type=3#arrow-down&quot;);" />
    </ui:VisualElement>
</ui:UXML>
